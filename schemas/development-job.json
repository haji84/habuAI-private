{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared implementation-completeness request proposal v1",
  "$comment": "Not a job admission or executable contract. Python inspector additionally verifies hashes, parent-run path linkage, total size and timestamp relationships. No claim/result/controller is implemented by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "persistence", "purpose", "scope_version", "capability_id", "strategy_id", "strategy_key", "provenance", "need", "requirement_ids", "allowed_paths", "verification_profile", "acceptance_ids", "risk_class", "limits", "source_authenticity", "request_admitted", "execution_authorized", "scientific_authorized", "selection_authorized", "production_authorized", "github_facts_authenticated", "request_sha256"],
  "properties": {
    "schema_version": {"const": "habu-development-request-proposal-v1"},
    "persistence": {"const": "UNPUBLISHED_PROPOSAL"},
    "purpose": {"const": "IMPLEMENTATION_COMPLETENESS"},
    "scope_version": {"const": "habu-development-capability-map-v1"},
    "capability_id": {"const": "CONFIGURED_STAGE1_PARENT_DISPATCH_V2"},
    "strategy_id": {"const": "REUSE_SOURCE_STAGE1_V2"},
    "strategy_key": {"$ref": "#/$defs/hash"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "need": {"$ref": "#/$defs/need"},
    "requirement_ids": {"const": ["R005", "R026"]},
    "allowed_paths": {"const": ["src/research_pdca_adapter.py", "tests/test_research_pdca_adapter.py", "docs/specs/research-configured-stage1-parent-v2.md", "docs/reviews/research_configured_stage1_parent_v2_20261025.md"]},
    "verification_profile": {"const": "HABU_PYTHON_EXACT_HEAD_REVIEW_V1"},
    "acceptance_ids": {"const": ["PRESERVE_REQUEST_V1_V2_V3", "CALL_REVIEWED_SOURCE_STAGE1_V2", "BIND_EXACT_CONFIGURED_THREE", "SHARE_CONTEXT_FINAL_RESCAN", "KEEP_AUTHORITY_FALSE", "INDEPENDENT_REVIEW_EXACT_HEAD_UBUNTU_FRESH_MAIN"]},
    "risk_class": {"const": "ORDINARY_CODE_ONLY"},
    "limits": {"const": {"attempts": 2, "active_seconds_per_attempt": 3600, "active_seconds_total": 7200, "lease_seconds": 600}},
    "source_authenticity": {"const": "NOT_ATTESTED"},
    "request_admitted": {"const": false},
    "execution_authorized": {"const": false},
    "scientific_authorized": {"const": false},
    "selection_authorized": {"const": false},
    "production_authorized": {"const": false},
    "github_facts_authenticated": {"const": false},
    "request_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "need": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "capability_id", "capability_installed", "prerequisite_schema", "prerequisite_deployed"],
      "properties": {
        "kind": {"const": "CODE_CAPABILITY"},
        "capability_id": {"const": "CONFIGURED_STAGE1_PARENT_DISPATCH_V2"},
        "capability_installed": {"const": false},
        "prerequisite_schema": {"const": "habu-stage1-source-contract-v2"},
        "prerequisite_deployed": {"const": true}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["master_issue", "repository", "root_command_id", "parent_command_id", "parent_run_id", "operational_night", "source_commit", "protocol_sha256", "observed_at", "expires_at", "evidence"],
      "properties": {
        "master_issue": {"const": "haji84/AI-#1642"},
        "repository": {"const": "haji84/habuAI-private"},
        "root_command_id": {"$ref": "#/$defs/hash"},
        "parent_command_id": {"$ref": "#/$defs/hash"},
        "parent_run_id": {"$ref": "#/$defs/hash"},
        "protocol_sha256": {"$ref": "#/$defs/hash"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "operational_night": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "observed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "expires_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "maxLength": 512, "pattern": "^reports/pdca/[0-9]{4}-[0-9]{2}-[0-9]{2}/runs/[a-f0-9]{64}/[a-zA-Z0-9_./-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    }
  }
}
