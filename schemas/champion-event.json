{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "habu/champion-event.json",
  "title": "Committed sandbox Champion transition",
  "description": "Only the verified current pointer ancestry is active; orphan events are inactive. Production activation is blocked pending Task8 authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "qualification": {
      "const": "SANDBOX_MECHANICS"
    },
    "operation": {
      "enum": [
        "PROMOTE",
        "ROLLBACK"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_model_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "scientific_validation": {
      "const": "NOT_VALIDATED"
    }
  },
  "required": [
    "schema_version",
    "qualification",
    "operation",
    "reason",
    "event_sha256",
    "previous_event_sha256",
    "previous_model_id",
    "next_model_id",
    "activated_at",
    "model",
    "evidence",
    "scientific_validation"
  ],
  "additionalProperties": false
}
