{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Habu development cycle contract-only envelope v1",
  "description": "Python also verifies registry-owned source closure, exact byte hashes, fixed policy, bounded reads and readiness. This contract grants no scientific, fit, confirmation or production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "cycle_id", "base_main_sha", "frozen_at", "policy_ref", "code_manifest"],
  "properties": {
    "schema_version": {"const": "habu-codex-cycle-v1"},
    "kind": {"const": "DEVELOPMENT_CONTRACT_ONLY"},
    "cycle_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
    "base_main_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "policy_ref": {"$ref": "#/$defs/reference"},
    "code_manifest": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }
  }
}
