{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "persistence",
    "runtime_accounting",
    "origin",
    "events",
    "tip_sha256",
    "request_admitted",
    "execution_authorized",
    "scientific_authorized",
    "selection_authorized",
    "production_authorized",
    "github_facts_authenticated"
  ],
  "properties": {
    "schema_version": {
      "const": "habu-development-job-ledger-proposal-v1"
    },
    "persistence": {
      "const": "UNPUBLISHED_ACCOUNTING_PROPOSAL"
    },
    "runtime_accounting": {
      "const": "CALLER_DECLARED_NOT_ATTESTED"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "events": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/start"
          },
          {
            "$ref": "#/$defs/checkpoint"
          },
          {
            "$ref": "#/$defs/settle"
          },
          {
            "$ref": "#/$defs/expire"
          }
        ]
      }
    },
    "tip_sha256": {
      "$ref": "#/$defs/hash"
    },
    "request_admitted": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "scientific_authorized": {
      "const": false
    },
    "selection_authorized": {
      "const": false
    },
    "production_authorized": {
      "const": false
    },
    "github_facts_authenticated": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unauthenticated replayable development accounting proposal v1",
  "$comment": "Python replay is mandatory for semantic hashes, clocks, fencing, immutable identities and budgets. This shape schema grants no admission or execution.",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "clock": {
      "type": "string",
      "maxLength": 64,
      "description": "Aware ISO declaration validated by Python semantic replay; not clock authentication"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "master_issue",
        "repository",
        "root_command_id",
        "capability_id",
        "job_id",
        "anchor_night",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": "habu-development-job-origin-v1"
        },
        "master_issue": {
          "const": "haji84/AI-#1642"
        },
        "repository": {
          "const": "haji84/habuAI-private"
        },
        "root_command_id": {
          "$ref": "#/$defs/hash"
        },
        "capability_id": {
          "const": "CONFIGURED_STAGE1_PARENT_DISPATCH_V2"
        },
        "job_id": {
          "$ref": "#/$defs/hash"
        },
        "anchor_night": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "limits": {
          "const": {
            "attempts": 2,
            "active_ms_per_attempt": 3600000,
            "active_ms_total": 7200000,
            "lease_seconds": 600
          }
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "previous_sha256",
        "event_sha256",
        "now",
        "kind",
        "request",
        "lease_until",
        "attempt_id",
        "ordinal",
        "operation_id",
        "allowance_ms",
        "generation"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "previous_sha256": {
          "$ref": "#/$defs/hash"
        },
        "event_sha256": {
          "$ref": "#/$defs/hash"
        },
        "now": {
          "$ref": "#/$defs/clock"
        },
        "kind": {
          "const": "START"
        },
        "request": {
          "$ref": "development-job.json"
        },
        "lease_until": {
          "$ref": "#/$defs/clock"
        },
        "attempt_id": {
          "$ref": "#/$defs/hash"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "operation_id": {
          "$ref": "#/$defs/hash"
        },
        "allowance_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "previous_sha256",
        "event_sha256",
        "now",
        "kind",
        "attempt_id",
        "generation",
        "active_ms",
        "phase",
        "lease_until",
        "next_generation"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "previous_sha256": {
          "$ref": "#/$defs/hash"
        },
        "event_sha256": {
          "$ref": "#/$defs/hash"
        },
        "now": {
          "$ref": "#/$defs/clock"
        },
        "kind": {
          "const": "CHECKPOINT"
        },
        "attempt_id": {
          "$ref": "#/$defs/hash"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "active_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "phase": {
          "enum": [
            "ACTIVE",
            "WAITING_CI"
          ]
        },
        "lease_until": {
          "anyOf": [
            {
              "$ref": "#/$defs/clock"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "settle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "previous_sha256",
        "event_sha256",
        "now",
        "kind",
        "attempt_id",
        "generation",
        "active_ms",
        "next_generation",
        "outcome"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "previous_sha256": {
          "$ref": "#/$defs/hash"
        },
        "event_sha256": {
          "$ref": "#/$defs/hash"
        },
        "now": {
          "$ref": "#/$defs/clock"
        },
        "kind": {
          "const": "SETTLE"
        },
        "attempt_id": {
          "$ref": "#/$defs/hash"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "active_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "next_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "outcome": {
          "enum": [
            "SETTLED",
            "OVER_BUDGET"
          ]
        }
      }
    },
    "expire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "previous_sha256",
        "event_sha256",
        "now",
        "kind",
        "attempt_id",
        "generation",
        "next_generation",
        "outcome"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "previous_sha256": {
          "$ref": "#/$defs/hash"
        },
        "event_sha256": {
          "$ref": "#/$defs/hash"
        },
        "now": {
          "$ref": "#/$defs/clock"
        },
        "kind": {
          "const": "EXPIRE"
        },
        "attempt_id": {
          "$ref": "#/$defs/hash"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "next_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "outcome": {
          "const": "EXPIRED"
        }
      }
    }
  }
}
