  "owner_field_statement": "GPX tracking mostly represents continuous Habu search; prolonged stops may be rest. Owner reports complete logging of personal captures, including zero-capture exploration nights. Testimonial is not a source-bound audit receipt.",
  "method": {
    "source": "actual exact GPX bytes restored from Git blobs; part_*.txt joined with LF for October 14/15",
    "source_integrity": "Independently computed raw SHA-256 matched the existing evidence/gpx manifests for all four nights; exact bytes and point counts also match",
    "time": "Parse GPX time as UTC and report Asia/Tokyo local; never infer time for missing points",
    "stop_heuristic": "Consecutive GPX points with GuruMaps gom:speed <=0.8 m/s, within 30 m great-circle distance of candidate start, and consecutive timestamp deltas in (0,20] s; report groups lasting >=120 s.",
    "sensitivity_seconds": [
      120,
      300,
      600
    ],
    "purpose_label": "STOP_PURPOSE_UNKNOWN unless owner capture/reaction is nearby; capture-associated means NOT classified as rest.",
    "event_match": "Recorded events within 100 m of stop start point and within +/-10 minutes of any instant of the stop; no extra capture records counted",
    "jump_flag": "Pairwise GPS displacement/time >130 km/h for consecutive deltas (0,20] s, diagnostic location anomaly flag only",
    "gap_flag": "Consecutive timestamps >20 s; never bridge such gaps as observed search",
    "negative_policy": "No automatic negative labels. Source-qualified SEARCH/PASSAGE plus complete capture logging, source receipts, GPS QC and conflicting-positive resolution required.",
    "caveats": [
      "80-cm/s & 30-m & 2-minute cutoffs are provisional sensitivity parameters, not owner-stated rest thresholds.",
      "Momentary speed noise/jitter and recorded speed may split or hide stop episodes.",
      "Unmatched stop can be rest, capture handling or other purposes; UNKNOWN by default.",
      "No stop detection on Oct 8 does not mean no rest.",
      "GPS jumps must not imply traversed road segments.",
      "Observation-to-GPX consistency is not forecast accuracy."
    ],
    "speed_missing_policy": "Any interval with one source point missing <gom:speed> is UNKNOWN_SOURCE_SPEED in companion full partition; never assumed a searched or unsearched road.",
    "partition_evidence_path": "evidence/audits/2026-10-06_08_14_15-gpx-segment-partition.json"
  },
